# Database URLs
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finvault_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/finvault_db

# JWT Configuration (minimum 32 characters)
JWT_SECRET_KEY=finvault_super_secret_jwt_access_key_min_32_chars_long_12345
JWT_REFRESH_SECRET_KEY=finvault_super_secret_jwt_refresh_key_min_32_chars_long_67890
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Field-Level Encryption Keys (Versioned JSON dictionary mapping key_id to base64 32-byte key)
MASTER_ENCRYPTION_KEYS_JSON={"v1":"4BwVwFqYw6i7nI8Q9V0R1X2Y3Z4A5B6C7D8E9F0A1B2="}
CURRENT_KEY_ID=v1

# Selective Encryption: Encrypt only confidential items (2FA secrets, passwords, private notes)
# Extra encryption on amounts is removed for fast native SQL aggregations and reporting
ENCRYPT_AMOUNTS=false

# HMAC-SHA256 Blind Index Key for exact match searching
BLIND_INDEX_KEY=finvault_blind_index_hmac_secret_key_32_bytes_len_!

# Two-Factor Authentication
TOTP_ISSUER=FinVault

# Rate Limiting & Account Security
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
